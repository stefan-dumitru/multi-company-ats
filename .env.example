# Copy to .env and fill in. .env is git-ignored; never commit real values.
# These local-only values match docker-compose.yml.
POSTGRES_USER=ats
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=ats
# 127.0.0.1, not "localhost": on Windows with Docker Desktop, "localhost" tries IPv6 first and
# hangs for a long time before falling back.
DATABASE_URL=postgresql+psycopg://ats:change-me-locally@127.0.0.1:5433/ats
# The session cookie is HTTPS-only by default. Local development runs on plain http, so switch it
# off here. Never set this in staging or production.
COOKIE_SECURE=false
# Email. Locally every message goes to Mailpit (docker compose) and is readable at
# http://127.0.0.1:8025; nothing is ever delivered for real.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_STARTTLS=false
EMAIL_FROM=no-reply@ats.test
# File storage (resumes). Locally a small S3-compatible server runs in docker compose and is
# reachable at 127.0.0.1:9000; the bucket is created for you. In staging and production these point
# at the Railway bucket. All four must be set together, or none: without them the app still starts
# and only an upload or a download says storage is not available.
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_BUCKET=ats-resumes
S3_ACCESS_KEY_ID=local-access-key
S3_SECRET_ACCESS_KEY=local-secret-key-change-me
# Optional: S3_REGION (default us-east-1) and S3_ADDRESSING_STYLE (path, virtual or auto; default path).
# The address links in emails point at: the Vite dev server locally.
APP_BASE_URL=http://127.0.0.1:5173
# Signs the links in emails (invitations, verification, password reset). At least 32 characters;
# generate one with: python -c "import secrets; print(secrets.token_hex(32))". Changing it
# invalidates every link already sent.
SECRET_KEY=change-me-locally-use-a-long-random-value
