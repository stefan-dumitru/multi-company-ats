# Copy to .env and fill in. .env is git-ignored; never commit real values.
# These local-only values match docker-compose.yml.
POSTGRES_USER=ats
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=ats
# 127.0.0.1, not "localhost": on Windows with Docker Desktop, "localhost" tries IPv6 first and
# hangs for a long time before falling back.
DATABASE_URL=postgresql+psycopg://ats:change-me-locally@127.0.0.1:5433/ats
# The session cookie is HTTPS-only by default. Local development runs on plain http, so switch it
# off here. Never set this in staging or production.
COOKIE_SECURE=false
# Email. Locally every message goes to Mailpit (docker compose) and is readable at
# http://127.0.0.1:8025; nothing is ever delivered for real.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_STARTTLS=false
EMAIL_FROM=no-reply@ats.test
# The address links in emails point at: the Vite dev server locally.
APP_BASE_URL=http://127.0.0.1:5173
